# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=your-strong-db-password
DATABASE_ENCRYPTION_KEY=your-32-byte-encryption-key-generate-random

# ── LLM Provider ─────────────────────────────────────────────────────────────
# "openai" (default) or "ollama"
LLM_PROVIDER=openai

# OpenAI (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Ollama (required when LLM_PROVIDER=ollama)
# Assumes Ollama is running on the host machine
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TEMPERATURE=0

# ── Performance ───────────────────────────────────────────────────────────────
# Schema cache TTL in seconds (default: 1800 = 30 minutes)
SCHEMA_CACHE_TTL=1800
